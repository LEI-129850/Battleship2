<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- 129843 - Martim Correia -->
<!-- Convencao de nomes de classes e interfaces: PascalCase (UpperCamelCase),
     de acordo com o Google Java Style Guide e as Oracle Java Naming Conventions. -->
<module name="Checker">
    <property name="severity" value="error"/>
 
    <module name="TreeWalker">
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
            <property name="tokens"
                      value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, ANNOTATION_DEF, RECORD_DEF"/>
        </module>
    </module>
</module>
 
